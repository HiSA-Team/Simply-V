# Author: Federica Sarnataro
# Description: PS side (Zynq-7000, Cortex-A9 #0) of the PS <-> Simply-V mailbox test.
#   Bare-metal, no Xilinx BSP: the PS is initialized by XSDB (ps7_init, ps7_post_config)
#   before this program is loaded.

PROJECT = ps_mailbox

# ARM toolchain (e.g. gcc-arm-none-eabi in WSL, or the one shipped with Vitis)
ARM_PREFIX ?= arm-none-eabi-
CC    = $(ARM_PREFIX)gcc
RM    = rm -rf
MKDIR = @mkdir -p $(@D)

SRC_DIR = src
BIN_DIR = bin
SRCS    = $(wildcard $(SRC_DIR)/*.c) $(wildcard $(SRC_DIR)/*.S)

# Headers: mailbox layout (CPU example) and SoC address map (generated by make config)
SW_ROOT ?= $(abspath ../../..)
INCS = -I$(SRC_DIR) \
       -I$(SW_ROOT)/SoC/examples/ps_mailbox/inc \
       -I$(SW_ROOT)/SoC/lib/simplyv/inc

# Cortex-A9, ARM mode, no FPU.
# MMU and caches are off after reset, so all data accesses are Strongly-ordered:
# no unaligned accesses allowed.
CFLAGS  = -mcpu=cortex-a9 -marm -mfloat-abi=soft -mno-unaligned-access \
          -ffreestanding -nostdlib -O1 -g -Wall
LDFLAGS = -nostartfiles -nostdlib -T $(SRC_DIR)/ps.ld -lgcc

all: $(BIN_DIR)/$(PROJECT).elf

$(BIN_DIR)/$(PROJECT).elf: $(SRCS) $(SRC_DIR)/ps.ld
	$(MKDIR)
	$(CC) $(CFLAGS) $(INCS) -o $@ $(SRCS) $(LDFLAGS)

clean:
	$(RM) $(BIN_DIR)

.PHONY: all clean
